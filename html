<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bayou Boudin Bites</title>
  <link rel="stylesheet" href="style.css">
  <link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

  <header class="bg-warning text-center py-5">
    <h1 class="display-4 fw-bold">Bayou Boudin &amp; Bites</h1>
    <p class="lead">Serving up authentic Creole and Cajun favorites hot off the grill!</p>
    <a href="#menu" class="btn btn-dark btn-lg">See the menu</a>
  </header>

  <main class="container py-5">
    <section id="menu">
      <h2 class="mb-4">Menu</h2>
      <div class="row g-4">

        <!-- Card 1 -->
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-body">
              <h3 class="card-title h5">Crawfish Étouffée</h3>
              <p class="card-text">Rich, buttery Cajun roux simmered with Louisiana crawfish tails and served over steamed white rice.</p>
              <p class="fw-bold text-success mb-0">$15.50</p>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-body">
              <h3 class="card-title h5">Chicken &amp; Sausage Gumbo</h3>
              <p class="card-text">Dark roux stew loaded with smoked andouille sausage, tender chicken, okra, and file powder.</p>
              <p class="fw-bold text-success mb-0">$13.00</p>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-body">
              <h3 class="card-title h5">Praline Beignets</h3>
              <p class="card-text">Three warm, pillowy French-style doughnuts dusted with powdered sugar and drizzled with pecan praline sauce.</p>
              <p class="fw-bold text-success mb-0">$6.50</p>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>
<script src="script.js"></script>
</body>
</html>